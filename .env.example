APP_NAME=MetroFlow AI
APP_VERSION=1.0.0
DEBUG=False
SQL_ECHO=False


DATABASE_URL=postgresql://postgres.xxxxxxxx:your_url_encoded_password@aws-x-xxxxx.pooler.supabase.com:6543/postgres


DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300


SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_or_publishable_key


SUPABASE_SERVICE_ROLE_KEY=


CORS_ORIGINS=http://localhost:3000


REDIS_URL=rediss://default:your_token@your-endpoint.upstash.io:6379
CACHE_ENABLED=True
CACHE_TTL_SECONDS=5


AUTH_DISABLED=False


ENABLE_SIMULATOR=True
SIMULATOR_INTERVAL_SECONDS=60
SIMULATOR_PASSENGER_POOL_SIZE=40
SIMULATOR_MAX_CHECKINS_PER_TICK=6

ENABLE_TRAIN_TRACKING=True
TRAIN_TRACK_INTERVAL_SECONDS=60

ENABLE_CROWD_RETENTION_JOB=True
ENABLE_NOTIFICATION_BIN_RETENTION_JOB=True


WEB_CONCURRENCY=1


AI_EAGER_WARMUP=False
AI_MODEL_LIGHT_MODE=True


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MetroFlow Alerts
SMTP_USE_TLS=True


TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


GEMINI_API_KEY=