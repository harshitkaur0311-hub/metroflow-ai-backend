# Copy this to .env and fill in real values. Never commit the real .env.

# --- Database (docker-compose sets DATABASE_URL itself; only needed
#     standalone / on EC2 without compose overriding it) ---
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://metroflow:change_me@db:5432/metroflow

# --- Cache / realtime relay ---
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=True

# --- Supabase (auth) — from your Supabase project settings ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# --- CORS — your deployed frontend URL(s), comma-separated ---
CORS_ORIGINS=https://your-frontend.vercel.app

# --- Simulator / background jobs ---
ENABLE_SIMULATOR=True
ENABLE_TRAIN_TRACKING=True
ENABLE_CROWD_RETENTION_JOB=True
ENABLE_NOTIFICATION_BIN_RETENTION_JOB=True

# --- Runtime tuning ---
# 1 worker process keeps memory use on a 512MB free-tier instance
# (e.g. Render's free plan) from doubling. Raise this only once you've
# moved to an instance with more RAM.
WEB_CONCURRENCY=1

# --- Free-tier / low-memory deployment knobs (see app/core/config.py) ---
# AI_EAGER_WARMUP=False spreads the 3 ML model bundles' load cost over
# the first few requests/simulator ticks instead of all at once at
# boot - the real memory-saving lever here.
# AI_MODEL_LIGHT_MODE=False (default) keeps both random_forest AND
# xgboost loaded per bundle for the dashboard's side-by-side
# comparison - measured cost of the extra candidates is only ~4MB
# total, not worth losing the feature over. Only flip to True if
# you're still right at the OOM line after everything else.
AI_EAGER_WARMUP=False
AI_MODEL_LIGHT_MODE=False

# --- Optional: email/SMS alert dispatch ---
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Optional: AI chatbot widget ---
GEMINI_API_KEY=
